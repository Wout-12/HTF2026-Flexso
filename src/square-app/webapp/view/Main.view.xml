<mvc:View
    controllerName="oakhaven.square.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:c="oakhaven.square.control"
    core:require="{ DateTime: 'sap/ui/model/type/DateTime' }"
    displayBlock="true"
    height="100%">
    <Page id="page" class="sqPage" showHeader="false">
        <content>
            <VBox id="square" class="sqSquare" renderType="Bare">
                <c:Sky id="sky" />
                <HBox id="head" class="sqHead" renderType="Bare">
                    <Title id="title" class="sqTitle" text="{i18n>appTitle}" level="H1" wrapping="true" />
                    <Text id="now" class="sqNow" text="{path: 'view>/now', type: 'DateTime', formatOptions: {pattern: 'EEE d MMM HH:mm'}}" />
                </HBox>
                <MessageStrip id="lost" text="{i18n>lost}" type="Error" showIcon="true" visible="{view>/lost}" />
                <HBox id="main" class="sqMain" renderType="Bare">
                    <VBox id="weatherBox" class="sqWeatherBox" renderType="Bare">
                        <Title id="weatherTitle" class="sqBoardTitle" text="{i18n>weatherTitle}" level="H2" />
                        <HBox id="today" class="sqToday" renderType="Bare">
                            <c:Weather id="weather" sky="{view>/today/sky}" label="{view>/today/skyText}" />
                            <VBox id="todayText" class="sqTodayText" renderType="Bare">
                                <Title id="high" class="sqHigh" text="{view>/today/high}" level="H3" />
                                <Text id="todaySky" class="sqSkyText" text="{view>/today/skyText}" />
                                <Text id="low" class="sqSmall" text="{view>/today/low}" />
                                <HBox id="rainBox" class="sqFact" renderType="Bare">
                                    <core:Icon id="rainIcon" src="sap-icon://ti/umbrella" alt="{i18n>rainLabel}" tooltip="{i18n>rainLabel}" decorative="false" />
                                    <Text id="rain" class="sqSmall" text="{view>/today/rain}" />
                                </HBox>
                                <HBox id="windBox" class="sqFact" renderType="Bare">
                                    <core:Icon id="windIcon" src="sap-icon://ti/wind" alt="{i18n>windLabel}" tooltip="{i18n>windLabel}" decorative="false" />
                                    <Text id="wind" class="sqSmall" text="{view>/today/wind}" />
                                </HBox>
                            </VBox>
                        </HBox>
                        <Text id="report" textAlign="Center" class="sqSentence" text="{view>/report}" />
                        <HBox id="days" class="sqDays" renderType="Bare" items="{path: 'view>/days', templateShareable: false}">
                            <VBox id="day" class="sqDay" renderType="Bare">
                                <Text id="dayName" class="sqDayName" text="{view>label}" />
                                <c:Weather id="dayWeather" sky="{view>sky}" label="{view>skyText}" />
                                <Text id="daySky" class="sqSmall" text="{view>skyText}" />
                                <Text id="dayHigh" class="sqDayHigh" text="{view>high}" />
                                <Text id="dayRain" class="sqSmall" text="{view>rain}" tooltip="{i18n>rainLabel}" />
                            </VBox>
                        </HBox>
                        <Text id="source" class="sqSmall" text="{i18n>weatherSource}" />
                        <Button id="bell" class="sqBell" icon="sap-icon://ti/bell-ringing" text="{i18n>bellText}" tooltip="{i18n>bell}" press=".onBell" />
                        <Text id="demo" class="sqDemo" text="{i18n>demo}" visible="{view>/isDemo}" />
                    </VBox>
                    <VBox id="board" class="sqBoard" renderType="Bare">
                        <Title id="newsTitle" class="sqBoardTitle" text="{i18n>newsTitle}" level="H2" />
                        <HBox id="notices" class="sqNotices" renderType="Bare" items="{path: 'view>/news', templateShareable: false}">
                            <c:Notice id="notice" text="{view>text}" kind="{view>kind}" kindText="{view>kindText}" icon="{view>icon}" ribbon="{view>ribbon}" />
                        </HBox>
                    </VBox>
                </HBox>
                <c:Ticker id="ticker" text="{view>/ticker}" label="{i18n>tickerLabel}" />
            </VBox>
        </content>
    </Page>
</mvc:View>
